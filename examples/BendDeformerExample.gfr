__children["Animation"]["curves"]["curve0"].addKey( Gaffer.Animation.Key( 2.91666675, -0.400000006, Gaffer.Animation.Interpolation.Linear, -0.479999984, 0, 0.320000066, 0, Gaffer.Animation.TieMode.Scale ) )
__children["Animation"]["curves"]["curve0"].addKey( Gaffer.Animation.Key( 4.16666651, 0, Gaffer.Animation.Interpolation.Linear, 0.320000066, 0, 0.320000066, 0, Gaffer.Animation.TieMode.Scale ) )
